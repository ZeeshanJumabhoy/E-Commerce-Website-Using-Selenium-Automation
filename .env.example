# Copy this file to .env and fill in your values.
# All values here must also be added as GitHub Secrets in your repo:
#   Settings → Secrets and variables → Actions → New repository secret

# URL of the site under test
BASE_URL=https://advantageonlineshopping.com/#/

# Test account credentials
TEST_USERNAME=your_username_here
TEST_PASSWORD=your_password_here

# Set to "true" to run Chrome in headless mode (always true in CI)
HEADLESS=false

# Add any extra secrets below — mirror them in the workflow env: block
# SAFEPAY_USERNAME=
# SAFEPAY_PASSWORD=
# CARD_NUMBER=
